*.parquet

# Logs
*.log

# Alembic pycache
data/migrations/__pycache__/

# Daily notes — local only
notes/

# MLflow — local experiment tracking, not source code
mlruns/

# Airflow runtime logs and symlinks
logs/

# Terraform — keep tfvars.example tracked, ignore everything else
infra/.terraform/
infra/.terraform.lock.hcl
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/.terraform.tfstate.lock.info

# Frontend (Next.js)
frontend/.next/
frontend/node_modules/
frontend/.env.local
.codex/
